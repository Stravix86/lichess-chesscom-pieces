{
  "manifest_version": 3,
  "name": "Lichess Chess.com Pieces",
  "version": "1.0.0",
  "description": "Replace Lichess pieces with Chess.com piece sets.",
  "permissions": ["storage"],
  "host_permissions": ["https://images.chesscomfiles.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["themes.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "exclude_matches": [
        "https://lichess.org/api/*",
        "https://lichess.org/assets/*",
        "https://lichess.org/game/export/*",
        "https://lichess.org/*.pgn"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Chess.com pieces",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": { "id": "lichess-chesscom-pieces@local" }
  }
}
